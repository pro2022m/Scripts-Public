# --- Database (Vercel Postgres / Neon / local Postgres) ---
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"
# For Vercel Postgres, also expose the non-pooled URL for migrations:
DIRECT_URL="postgresql://user:password@host:5432/dbname?schema=public"

# --- Auth.js v5 ---
# openssl rand -base64 32
AUTH_SECRET=""
AUTH_TRUST_HOST="true"

# --- Microsoft Entra ID (optional) ---
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_TENANT_ID=""

# --- Seed (used by `pnpm db:seed`) ---
SEED_OWNER_EMAIL="owner@example.com"
SEED_OWNER_NAME="Initial Owner"
# If set, seeds a local password for the owner (Argon2-hashed).
# If unset, the owner can only sign in via Microsoft SSO.
SEED_OWNER_PASSWORD=""
